{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "material-mcp",
    "main": "src/index.ts",
    "compatibility_date": "2026-04-24",
    "compatibility_flags": ["nodejs_compat"],
    "browser": {
        "binding": "BROWSER",
        "remote": true,
    },
    "ai": {
        "binding": "AI",
        "remote": true,
    },
}
